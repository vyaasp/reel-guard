  "cues": [
    {
      "from": 0,
      "to": 85,
      "text": "From the space station, night moves quickly."
    },
    {
      "from": 92,
      "to": 174,
      "text": "At first, the ground is hard to see."
    },
    {
      "from": 181,
      "to": 260,
      "text": "Then city lights trace the edge of the coast."
    },
    {
      "from": 267,
      "to": 369,
      "text": "Over the ocean, lightning flashes through the clouds."
    },
    {
      "from": 376,
      "to": 476,
      "text": "Farther south, a green ribbon comes into view."
    },
    {
      "from": 483,
      "to": 556,
      "text": "That's the aurora, high above the weather."
    },
    {
      "from": 563,
      "to": 647,
      "text": "Charged particles stir the upper atmosphere,"
    },
    {
      "from": 654,
      "to": 733,
      "text": "and the sky glows as the station passes."
    },
    {
      "from": 740,
      "to": 837,
      "text": "At the edge of the planet, a thin line brightens."
    },
    {
      "from": 844,
      "to": 892,
      "text": "Then daylight takes over."
    },
    {
      "from": 899,
      "to": 995,
      "text": "Below the station, the ocean turns blue again."
    }
  ],
